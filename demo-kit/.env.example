# Foundry Control Plane demo kit — environment template (copy to .env; never commit real values)
# Sources: https://github.com/Azure/azure-sdk-for-python/blob/main/sdk/ai/azure-ai-projects/samples/agents/sample_agent_basic.py
#          https://learn.microsoft.com/en-us/azure/foundry/agents/how-to/manage-hosted-agent
#          https://github.com/microsoft/opentelemetry-distro-python/tree/main/samples/langchain
#          https://learn.microsoft.com/en-us/azure/foundry/control-plane/register-custom-agent

# --- Foundry project (SDK samples) ---
# "The Azure AI Project endpoint, as found in the Overview page of your Microsoft Foundry portal."
# Form: https://<account_name>.services.ai.azure.com/api/projects/<project_name>
FOUNDRY_PROJECT_ENDPOINT=<PROJECT_ENDPOINT>
# "The deployment name of the AI model, as found under the 'Name' column in the 'Models + endpoints' tab"
FOUNDRY_MODEL_NAME=<MODEL_DEPLOYMENT_NAME>
# Prompt agent name used across modules 02/04/05
FOUNDRY_AGENT_NAME=zava-returns-assistant

# --- az rest data-plane variables (manage-hosted-agent) ---
ACCOUNT_NAME=<FOUNDRY_ACCOUNT_NAME>
PROJECT_NAME=<PROJECT_NAME>
AGENT_NAME=zava-returns-assistant

# --- ARM / RBAC ---
AZURE_SUBSCRIPTION_ID=<SUBSCRIPTION_ID>
AZURE_RESOURCE_GROUP_NAME=<RESOURCE_GROUP>
# Agent application + deployment names (only for published agent applications; ARM agentdeployments stop/start)
APPLICATION_NAME=<AGENT_APPLICATION_NAME>
DEPLOYMENT_NAME=<AGENT_DEPLOYMENT_NAME>
# RAI (guardrail) policy name to create on the account (module 07)
RAI_POLICY_NAME=zava-returns-guardrail

# --- AI Gateway (APIM) — the URL Foundry generates after Register asset (Operate > Assets > Agent URL > Copy) ---
# Documented example form: https://apim-my-foundry-resource.azure-api.net/my-custom-agent/
APIM_URL=<APIM_URL>
LANGGRAPH_ASSISTANT_ID=<ASSISTANT_ID>

# --- Custom LangGraph agent (module 03) ---
# "Also read from APPLICATIONINSIGHTS_CONNECTION_STRING" (microsoft-opentelemetry distro README)
APPLICATIONINSIGHTS_CONNECTION_STRING=<APP_INSIGHTS_CONNECTION_STRING>
# Model endpoint/key used by the distro LangChain sample (ChatOpenAI base_url / api_key)
AZURE_OPENAI_ENDPOINT=<AZURE_OPENAI_ENDPOINT>
AZURE_OPENAI_API_KEY=<AZURE_OPENAI_API_KEY>
# Distro sample README: env vars to view GenAI telemetry content
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=SPAN_AND_EVENT
OTEL_SEMCONV_STABILITY_OPT_IN=gen_ai_latest_experimental
AZURE_EXPERIMENTAL_ENABLE_GENAI_TRACING=true

# --- Red team against a MODEL deployment (samples/red_team/sample_red_team.py) — optional ---
MODEL_ENDPOINT=<MODEL_ENDPOINT>      # https://<account_name>.services.ai.azure.com
MODEL_API_KEY=<MODEL_API_KEY>

# --- Scheduled dataset evaluation (module 05) — file id of an uploaded dataset ---
DATASET_FILE_ID=<DATASET_FILE_ID>
